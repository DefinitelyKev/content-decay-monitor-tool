// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanTier {
  FREE
  CREATOR
  PRO
  AGENCY
}

enum SiteStatus {
  ACTIVE
  PAUSED
  ERROR
}

enum ContentStatus {
  HEALTHY
  WARNING
  DECAYING
  RECOVERED
}

enum AlertType {
  POSITION_DROP
  POSITION_RECOVERED
  CONTENT_DECAY
  COMPETITOR_CHANGE
}

model User {
  id               String    @id @default(cuid())
  clerkId          String    @unique
  email            String    @unique
  stripeCustomerId String?   @unique
  planTier         PlanTier  @default(FREE)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sites            Site[]
  alerts           Alert[]

  @@index([clerkId])
  @@index([email])
}

model Site {
  id            String      @id @default(cuid())
  userId        String
  domain        String
  gscConnected  Boolean     @default(false)
  status        SiteStatus  @default(ACTIVE)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  content       Content[]

  @@unique([userId, domain])
  @@index([userId])
}

model Content {
  id               String         @id @default(cuid())
  siteId           String
  url              String
  title            String?
  targetKeyword    String
  currentPosition  Int?
  previousPosition Int?
  highestPosition  Int?
  lastCheckedAt    DateTime?
  status           ContentStatus  @default(HEALTHY)
  contentScore     Float?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  site             Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  keywords         Keyword[]
  rankings         Ranking[]
  alerts           Alert[]

  @@unique([siteId, url])
  @@index([siteId])
  @@index([status])
}

model Keyword {
  id                   String   @id @default(cuid())
  contentId            String
  keyword              String
  position             Int?
  searchVolume         Int?
  historicalPositions  Json?    // JSONB for time series data
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  content              Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  rankings             Ranking[]

  @@unique([contentId, keyword])
  @@index([contentId])
}

model Ranking {
  id            String   @id @default(cuid())
  contentId     String
  keywordId     String
  position      Int
  date          DateTime @default(now())
  serpFeatures  Json?    // JSONB for SERP features
  createdAt     DateTime @default(now())

  content       Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  keyword       Keyword  @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@index([keywordId])
  @@index([date])
}

model Alert {
  id          String     @id @default(cuid())
  userId      String
  contentId   String
  alertType   AlertType
  message     String
  triggeredAt DateTime   @default(now())
  resolvedAt  DateTime?

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  content     Content    @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([contentId])
  @@index([triggeredAt])
}
